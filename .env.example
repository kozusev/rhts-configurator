# Copy this file to ".env" and fill in real values (never commit the real .env).
# On Railway, set these as project Variables instead.

# --- Database (Postgres) ---
# On Railway: add a Postgres database, then reference it on the app service as
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# For local dev / running the data import, use the Postgres PUBLIC connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Admin panel ---
# Bootstrap admin account created on first login if the user table is empty.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Long random string used to sign login-session cookies. Generate a new one for production.
AUTH_SECRET="please-change-this-to-a-long-random-string"

# --- Email (leave SMTP_HOST empty to run in PREVIEW mode: emails are saved to .mail-preview/ instead of sent) ---
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="user@example.com"
# SMTP_PASS="your-password"
# SMTP_FROM="RHTS <no-reply@example.com>"
